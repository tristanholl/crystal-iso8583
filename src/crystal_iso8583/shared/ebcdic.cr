      # Reverse table: index is the ASCII/ISO-8859-1 byte, value is the EBCDIC byte.
      # Unmapped ASCII bytes default to 0x3F (EBCDIC '?').
      TO_EBCDIC = begin
        table = Array(UInt8).new(256, 0x3Fu8)
        TO_ASCII.each_with_index { |ascii_val, ebcdic_idx| table[ascii_val] = ebcdic_idx.to_u8 }
        table
      end
