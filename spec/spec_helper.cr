require "spec"
require "../src/crystal_iso8583"

# Hand-crafted binary for a minimal ISO 8583:1987 0100 message.
# Fields present: DE 2, 3, 4, 7, 11, 12, 13, 14
#
# MTI:    [0x01, 0x00]  (BCD "0100")
# Bitmap: byte0=0x72 (DE2|DE3|DE4|DE7), byte1=0x3C (DE11|DE12|DE13|DE14), bytes2-7=0x00
# DE 2  LLVAR N: len=[0x16] (16 digits), data=0x41111111_11111111 (PAN 4111111111111111)
# DE 3  N 6:     [0x00, 0x00, 0x00]           (ProcessingCode 000000)
# DE 4  N 12:    [0x00, 0x00, 0x00, 0x00, 0x10, 0x00] (Amount 000000001000)
# DE 7  N 10:    [0x06, 0x12, 0x15, 0x30, 0x45]       (0612153045)
# DE 11 N 6:     [0x00, 0x01, 0x23]                    (STAN 000123)
# DE 12 N 6:     [0x15, 0x30, 0x45]                    (LocalTime 153045)
# DE 13 N 4:     [0x06, 0x12]                          (LocalDate 0612)
# DE 14 N 4:     [0x25, 0x12]                          (Expiry 2512)
SAMPLE_0100 = Bytes[
  0x01, 0x00,
  0x72, 0x3C, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
  0x16, 0x41, 0x11, 0x11, 0x11, 0x11, 0x11, 0x11, 0x11,
  0x00, 0x00, 0x00,
  0x00, 0x00, 0x00, 0x00, 0x10, 0x00,
  0x06, 0x12, 0x15, 0x30, 0x45,
  0x00, 0x01, 0x23,
  0x15, 0x30, 0x45,
  0x06, 0x12,
  0x25, 0x12,
]

# Same field payload as SAMPLE_0100 but with ISO 8583:1993 ASCII MTI "1100"
